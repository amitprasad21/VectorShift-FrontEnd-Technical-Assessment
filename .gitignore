# ==========================================
# Flow Workspace Unified .gitignore File
# Prevents heavy dependencies, sensitive credentials,
# caches, and temporary files from being committed.
# ==========================================

# Dependency Directories
node_modules/
frontend/node_modules/
frontend/build/
frontend/coverage/
/.pnp
.pnp.js

# Python Virtual Environments
.venv/
venv/
env/
ENV/
python_env/

# Python Cache & Temporary Files
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
backend/__pycache__/

# Environment Variables & Sensitive Credentials (DO NOT COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
private.key
secrets.json

# IDE / Editor Settings & Layouts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.project
.classpath
.settings/

# OS System Files
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# Logs, Diagnostics & Diagnostics Stackdumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/grep.exe.stackdump
**/stackdump
